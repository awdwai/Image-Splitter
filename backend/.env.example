# AnimAI backend environment example
# Copy to .env and adjust as needed.

ANIMAI_HOST=0.0.0.0
ANIMAI_PORT=8000
ANIMAI_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional API key auth (leave empty to disable; when set, send header X-API-Key)
ANIMAI_API_KEY=

# Storage / jobs (scaffold defaults)
ANIMAI_DATA_DIR=./data
ANIMAI_JOB_STORE=memory

# Default stub providers (override later when real models are wired)
ANIMAI_DEFAULT_DETECTION_PROVIDER=stub-detection
ANIMAI_DEFAULT_POSE_PROVIDER=stub-pose
ANIMAI_DEFAULT_SEGMENTATION_PROVIDER=stub-segmentation
ANIMAI_DEFAULT_INPAINTING_PROVIDER=stub-inpainting
